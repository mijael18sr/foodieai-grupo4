# =====================================================
# Restaurant Recommender - Environment Variables
# =====================================================
# Copy this file to .env and fill in the values
# DO NOT commit the .env file to version control!

# ===========================================
# General Configuration
# ===========================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ===========================================
# Backend Configuration
# ===========================================
BACKEND_PORT=8000
API_HOST=0.0.0.0
API_PORT=8000

# Data and Model Paths
MODEL_PATH=/app/data/models/
DATA_PATH=/app/data/

# Specific Model Files
SENTIMENT_MODEL=sentiment_model.pkl
CLUSTERING_MODEL=clustering_model.pkl
RATING_PREDICTOR=rating_predictor.pkl
RECOMMENDER_MODEL=recommender_system.pkl

# ===========================================
# Frontend Configuration
# ===========================================
FRONTEND_PORT=80
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=Restaurant Recommender
VITE_APP_VERSION=2.0.0

# ===========================================
# CORS Configuration
# ===========================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80
FRONTEND_URL=http://localhost:3000

# ===========================================
# MLflow Configuration
# ===========================================
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_PORT=5000
MLFLOW_EXPERIMENT_NAME=restaurant-recommender

# ===========================================
# Database Configuration (Optional)
# ===========================================
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_USER=restaurant
# POSTGRES_PASSWORD=your_secure_password_here
# POSTGRES_DB=restaurant_db
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ===========================================
# Redis Cache Configuration (Optional)
# ===========================================
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password_here

# ===========================================
# AWS Configuration
# ===========================================
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here

# ECR Configuration
# ECR_REGISTRY=your_account_id.dkr.ecr.us-east-1.amazonaws.com
# ECR_REPOSITORY_BACKEND=restaurant-recommender-backend
# ECR_REPOSITORY_FRONTEND=restaurant-recommender-frontend

# ECS Configuration
# ECS_CLUSTER=restaurant-recommender-cluster
# ECS_SERVICE_BACKEND=restaurant-backend-service
# ECS_SERVICE_FRONTEND=restaurant-frontend-service

# ===========================================
# Monitoring & Logging
# ===========================================
ENABLE_METRICS=true
PROMETHEUS_PORT=9090

# ===========================================
# Security
# ===========================================
# JWT_SECRET_KEY=your_super_secret_jwt_key_here
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=60
