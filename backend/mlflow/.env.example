# =============================================================================
# MLflow Configuration
# =============================================================================

# Database Configuration (PostgreSQL RDS)
MLFLOW_BACKEND_STORE_URI=postgresql://mlflow_admin:MLflow2025Secure!@${RDS_ENDPOINT}/mlflow

# S3 Artifacts Configuration
MLFLOW_ARTIFACT_ROOT=s3://foodie-ai-static-assets/mlflow-artifacts
AWS_DEFAULT_REGION=us-east-2

# Server Configuration
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000

# Optional: Authentication (uncomment to enable)
# MLFLOW_TRACKING_USERNAME=admin
# MLFLOW_TRACKING_PASSWORD=your-secure-password
